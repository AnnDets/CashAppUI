# Self-contained multi-stage build for StorkCI/Kaniko.
# The repo's plain Dockerfile assumes a pre-built ./build/ dir (old mirror-CI flow);
# this produces the CRA production build in-image so Kaniko can build from a clean clone.
# --legacy-peer-deps: react-scripts 5.0.1 peers react ^17||^18 but the app uses react 19.
# Build-time config (REACT_APP_BASE_URL, keycloak url/realm) is baked from the committed .env / source.
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY . .
ENV CI=false
ENV GENERATE_SOURCEMAP=false
RUN npm run build

# Runtime stage — matches the original deploy image (nginx:alpine serving the CRA build
# under /app/ per nginx.conf; homepage=/app).
FROM nginx:alpine
COPY --from=build /app/build/ /usr/share/nginx/html/build/
COPY --from=build /app/public/favicon.ico /usr/share/nginx/html/
COPY --from=build /app/public/manifest.json /usr/share/nginx/html/
COPY --from=build /app/public/robots.txt /usr/share/nginx/html/
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
